# ─── Database (Neon Postgres) ───────────────────────────────
# Pooled connection string (for the app). Use the Neon "pooled" URL.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string — used by Prisma Migrate only.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js (Google OAuth + JWT sessions) ──────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Public base URL (http://localhost:3000 in dev).
AUTH_URL="http://localhost:3000"

# ─── Razorpay (payments) — wired in a later phase ───────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Cloudflare storage (R2 images / Stream video) ──
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
# Stream API token with "Stream:Edit" — powers in-admin uploads + status
CLOUDFLARE_STREAM_TOKEN=""
# Optional: your account's playback subdomain, e.g. customer-abc123.cloudflarestream.com
# Leave blank to fall back to iframe.videodelivery.net
NEXT_PUBLIC_STREAM_CUSTOMER_SUBDOMAIN=""

# ─── AI companion (Daylight) — provider TBD, not wired yet ──
AI_PROVIDER=""
AI_API_KEY=""
